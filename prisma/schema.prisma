// Prisma schema para sistema de procesamiento de documentos financieros MULTI-TENANT
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase connection string format:
  // postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public
}

// TENANT/ORGANIZACIÓN - Sistema multi-tenant
model Tenant {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique // Para URLs: cliente1.sistema.com
  subdomain     String?   @unique // Subdominio opcional
  customDomain  String?   @unique // Dominio personalizado
  
  // Configuración
  plan          TenantPlan @default(FREE)
  isActive      Boolean   @default(true)
  settings      Json?     // Configuraciones específicas del tenant
  
  // Límites del plan
  maxUsers      Int       @default(5)
  maxDocuments  Int       @default(100)
  maxStorageGB  Int       @default(1)
  
  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relaciones
  users         TenantUser[]
  documents     Document[]
  integrations  Integration[]
  automations   Automation[]
  
  @@index([slug])
  @@index([subdomain])
  @@index([isActive])
  @@map("tenants")
}

// Relación muchos a muchos entre Users y Tenants
model TenantUser {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  role          TenantRole @default(MEMBER)
  
  // Metadata
  joinedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relaciones
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

// Usuarios del sistema (ahora multi-tenant)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relaciones
  tenantUsers   TenantUser[]
  documents     Document[]
  feedbacks     DocumentFeedback[]
  
  @@map("users")
}

// Documentos procesados (multi-tenant)
model Document {
  id                String      @id @default(cuid())
  tenantId          String      // MULTI-TENANT: Aislado por tenant
  userId            String
  fileName          String
  fileUrl           String
  fileSize          Int
  mimeType          String
  
  // Estado del procesamiento
  status            DocumentStatus @default(QUEUED)
  jobId             String?      @unique
  
  // Clasificación
  documentType      DocumentType?
  subtype           String?
  confidence        Float?
  classification    Json?            // Clasificación completa con type, confidence, etc.
  classificationReason String?

  // Datos extraídos (JSON)
  extractedData     Json?

  // Performance
  processingTime    Int?             // Tiempo de procesamiento en ms
  
  // Validación
  validationStatus  ValidationStatus @default(PENDING)
  validatedAt       DateTime?
  validatedBy       String?
  
  // Metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  processedAt       DateTime?
  
  // Retry
  retryCount        Int         @default(0)
  errorMessage      String?
  
  // Relaciones
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks         DocumentFeedback[]
  exports           ExportLog[]

  // Relaciones con tablas especializadas
  factura           Factura?
  resumenTarjeta    ResumenTarjeta?
  servicio          Servicio?
  impuesto          Impuesto?
  ticket            Ticket?
  driveFile         DriveFile?

  // Nuevas relaciones
  templateId        String?  // Template usado para procesar este documento
  template          DocumentTemplate? @relation(fields: [templateId], references: [id])
  ocrResult         OCRResult?
  conversations     ExtractionConversation[]

  @@index([tenantId, userId]) // Índice compuesto para consultas multi-tenant
  @@index([templateId])
  @@index([tenantId, status])
  @@index([tenantId, documentType])
  @@index([tenantId, createdAt])
  @@index([jobId])
  @@map("documents")
}

// Feedback de usuario para aprendizaje
model DocumentFeedback {
  id              String   @id @default(cuid())
  documentId      String
  userId          String

  // Correcciones realizadas
  corrections     Json     // Array de { field, originalValue, correctedValue, correctionType }

  // Metadata
  createdAt       DateTime @default(now())

  // Relaciones
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@map("document_feedbacks")
}

// ==============================================================================
// TABLAS ESPECIALIZADAS POR TIPO DE DOCUMENTO
// ==============================================================================

// Facturas - Datos estructurados de facturas
model Factura {
  id                String   @id @default(cuid())
  documentId        String   @unique
  tenantId          String

  // Información básica
  tipo              String   // A, B, C, E, M
  numero            String
  punto_venta       String?
  fecha_emision     DateTime?

  // Emisor
  emisor_nombre     String?
  emisor_cuit       String?
  emisor_direccion  String?
  emisor_condicion_iva String?

  // Receptor
  receptor_nombre   String?
  receptor_cuit     String?
  receptor_direccion String?
  receptor_condicion_iva String?

  // Items (JSON array)
  items             Json?    // Array de items con código, descripción, cantidad, precio, etc.

  // Totales
  subtotal          Float?
  iva_105           Float?
  iva_21            Float?
  iva_27            Float?
  otros_impuestos   Float?
  total             Float?

  // Datos AFIP
  cae               String?
  vencimiento_cae   DateTime?
  codigo_barras     String?
  qr_data           String?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([emisor_cuit])
  @@index([receptor_cuit])
  @@index([fecha_emision])
  @@map("facturas")
}

// Resúmenes de tarjeta de crédito
model ResumenTarjeta {
  id                String   @id @default(cuid())
  documentId        String   @unique
  tenantId          String

  // Información básica
  banco_emisor      String?
  tipo_tarjeta      String?  // visa, mastercard, amex, etc.
  numero_tarjeta_enmascarado String?
  titular           String?
  fecha_cierre      DateTime?
  fecha_vencimiento DateTime?

  // Resumen anterior
  saldo_anterior    Float?
  pago_anterior     Float?
  ajustes           Float?

  // Consumos (JSON array)
  consumos          Json?    // Array de consumos con fecha, comercio, importe, etc.

  // Totales
  total_consumos    Float?
  intereses         Float?
  cargos_servicios  Float?
  impuestos         Float?
  total_resumen     Float?
  pago_minimo       Float?
  pago_total_sin_interes Float?

  // Cuotas vigentes (JSON array)
  cuotas_vigentes   Json?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([banco_emisor])
  @@index([fecha_cierre])
  @@map("resumenes_tarjeta")
}

// Servicios (luz, gas, agua, internet, etc.)
model Servicio {
  id                String   @id @default(cuid())
  documentId        String   @unique
  tenantId          String

  // Información básica
  tipo_servicio     String   // luz, gas, agua, internet, telefonia, cable
  empresa_proveedora String?
  numero_cuenta     String?
  numero_medidor    String?
  titular           String?
  domicilio_suministro String?

  // Período facturado
  fecha_desde       DateTime?
  fecha_hasta       DateTime?
  dias_facturados   Int?

  // Consumo
  lectura_anterior  Float?
  lectura_actual    Float?
  consumo_unidades  Float?
  unidad_medida     String?  // kWh, m3, MB
  precio_unitario   Float?

  // Cargos (JSON array)
  cargos            Json?

  // Totales
  subtotal          Float?
  iva               Float?
  impuestos_municipales Float?
  otros_cargos      Float?
  total_a_pagar     Float?

  // Vencimientos
  primer_vencimiento DateTime?
  segundo_vencimiento DateTime?
  recargo_segundo_venc Float?

  // Datos de pago
  codigo_pago_electronico String?
  codigo_barras     String?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tipo_servicio])
  @@index([empresa_proveedora])
  @@index([primer_vencimiento])
  @@map("servicios")
}

// Impuestos (ARBA, ABL, Patente, etc.)
model Impuesto {
  id                String   @id @default(cuid())
  documentId        String   @unique
  tenantId          String

  // Información básica
  tipo_impuesto     String   // arba, abl, patente, iibb, monotributo, ganancias
  organismo_recaudador String?
  jurisdiccion      String?
  contribuyente     String?
  cuit_cuil         String?
  domicilio         String?

  // Liquidación
  numero_partida    String?
  numero_liquidacion String?
  periodo_fiscal    String?
  año_fiscal        Int?
  anticipo_cuota    String?

  // Deuda
  capital           Float?
  intereses         Float?
  recargos          Float?
  total_deuda       Float?

  // Vencimientos (JSON array)
  vencimientos      Json?

  // Datos de pago
  codigo_pago_electronico String?
  cbu_debito_automatico String?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tipo_impuesto])
  @@index([cuit_cuil])
  @@map("impuestos")
}

// Tickets y comprobantes simples
model Ticket {
  id                String   @id @default(cuid())
  documentId        String   @unique
  tenantId          String

  // Información básica
  comercio          String?
  direccion         String?
  telefono          String?
  cuit              String?

  // Transacción
  numero_ticket     String?
  fecha_hora        DateTime?

  // Items (JSON array)
  items             Json?

  // Totales
  subtotal          Float?
  descuentos        Float?
  recargos          Float?
  total             Float?

  // Pago
  metodo_pago       String?  // efectivo, tarjeta, transferencia

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([comercio])
  @@index([fecha_hora])
  @@map("tickets")
}

// ==============================================================================
// SISTEMA DE APRENDIZAJE
// ==============================================================================

// Configuraciones de extracción aprendidas por proveedor/tipo
model ExtractionConfiguration {
  id                String   @id @default(cuid())
  tenantId          String

  // Identificación
  documentType      DocumentType
  supplierName      String?  // Nombre del proveedor (ej: "Edenor", "Visa")
  supplierCuit      String?  // CUIT del proveedor para matching exacto

  // Prompt personalizado aprendido
  customPrompt      String?  // Prompt adicional con instrucciones específicas

  // Configuración de campos
  fieldMappings     Json?    // Mapeo de campos: { "campo_documento": "campo_destino" }
  fieldDefaults     Json?    // Valores por defecto para campos faltantes

  // Reglas de validación aprendidas
  validationRules   Json?    // Reglas específicas por campo

  // Estadísticas
  successCount      Int      @default(0)  // Veces que se aplicó exitosamente
  correctionCount   Int      @default(0)  // Veces que se corrigió
  lastUsedAt        DateTime?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  // Usuario que generó la primera configuración

  @@unique([tenantId, documentType, supplierCuit])
  @@index([tenantId, documentType])
  @@index([supplierName])
  @@map("extraction_configurations")
}

// Reglas de aprendizaje - patrones específicos de corrección
model LearningRule {
  id                String   @id @default(cuid())
  tenantId          String
  configurationId   String?  // Opcional: vinculado a una configuración específica

  // Patrón
  documentType      DocumentType
  fieldName         String   // Campo al que aplica la regla

  // Transformación
  ruleType          LearningRuleType  // REPLACE, REGEX, MAPPING, CALCULATION
  pattern           String?  // Patrón a buscar (para REGEX)
  replacement       String?  // Reemplazo (para REPLACE/REGEX)
  mapping           Json?    // Diccionario de mapeo (para MAPPING)
  formula           String?  // Fórmula de cálculo (para CALCULATION)

  // Condiciones de aplicación
  conditions        Json?    // Condiciones para aplicar la regla

  // Estadísticas
  timesApplied      Int      @default(0)
  successRate       Float    @default(1.0)

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdFrom       String?  // ID del DocumentFeedback que la generó

  @@index([tenantId, documentType])
  @@index([tenantId, fieldName])
  @@index([configurationId])
  @@map("learning_rules")
}

// ==============================================================================
// SISTEMA DE PLANTILLAS PERSONALIZABLES (Templates)
// ==============================================================================

// Plantillas de extracción personalizables por usuario
model DocumentTemplate {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String   // Usuario que creó la plantilla

  // Información básica
  name              String   // "Tickets de Supermercado", "Facturas Edenor"
  description       String?
  documentType      DocumentType?  // Opcional: puede ser template genérico

  // Prompt personalizado ("mini prompt")
  customPrompt      String   @db.Text  // El usuario puede editar esto
  systemPrompt      String?  @db.Text  // Prompt del sistema (opcional)

  // Configuración de extracción
  fields            TemplateField[]  // Campos a extraer

  // Auto-detección
  autoDetect        Boolean  @default(false)  // Aplicar automáticamente si detecta patrón
  detectionRules    Json?    // Reglas para auto-detectar (ej: si contiene "EDENOR")

  // Validaciones
  validationRules   Json?    // Reglas matemáticas, ej: "total = subtotal + iva"
  requiredFields    String[] // Campos obligatorios

  // Interactividad
  askIfMissing      Boolean  @default(true)   // Preguntar si falta información
  allowConversation Boolean  @default(true)   // Permitir refinamiento por chat

  // Estadísticas
  timesUsed         Int      @default(0)
  successRate       Float    @default(0.0)
  avgConfidence     Float    @default(0.0)

  // Metadata
  isPublic          Boolean  @default(false)  // Compartir con otros usuarios
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  documents         Document[]
  conversations     ExtractionConversation[]

  @@index([tenantId, userId])
  @@index([tenantId, documentType])
  @@index([isPublic, isActive])
  @@map("document_templates")
}

// Campos individuales de una plantilla
model TemplateField {
  id                String   @id @default(cuid())
  templateId        String

  // Definición del campo
  name              String   // nombre_tecnico (ej: "emisor_cuit")
  label             String   // Nombre amigable (ej: "CUIT del Emisor")
  description       String?  // Ayuda para el usuario

  // Tipo y validación
  fieldType         FieldType  // TEXT, NUMBER, DATE, SELECT, etc.
  isRequired        Boolean  @default(false)
  isArray           Boolean  @default(false)  // ¿Es un array de valores?

  // Para campos SELECT/MULTI_SELECT
  options           Json?    // ["opcion1", "opcion2"] o [{ value: "val", label: "Label" }]
  allowCustom       Boolean  @default(false)  // Permitir valores custom

  // Validaciones específicas
  validation        Json?    // { min: 0, max: 100, regex: "^\\d{2}-\\d{8}-\\d$" }
  defaultValue      Json?    // Valor por defecto

  // Extracción
  extractionHint    String?  // Hint para la IA: "Buscar después de 'CUIT:'"
  fallbackField     String?  // Campo alternativo si no encuentra este

  // Orden y agrupación
  order             Int      @default(0)
  group             String?  // "Emisor", "Receptor", "Totales"

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  template          DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([fieldType])
  @@map("template_fields")
}

// ==============================================================================
// SISTEMA DE CONVERSACIÓN INTERACTIVA
// ==============================================================================

// Conversaciones para refinamiento de extracción
model ExtractionConversation {
  id                String   @id @default(cuid())
  documentId        String
  templateId        String?
  tenantId          String
  userId            String

  // Estado
  status            ConversationStatus @default(ACTIVE)

  // Datos en progreso
  currentData       Json     // Datos extraídos hasta ahora
  missingFields     String[] // Campos que faltan
  uncertainFields   Json?    // Campos con baja confianza

  // Mensajes
  messages          ConversationMessage[]

  // Metadata
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  updatedAt         DateTime @updatedAt

  // Relaciones
  template          DocumentTemplate? @relation(fields: [templateId], references: [id])

  @@index([documentId])
  @@index([tenantId, userId])
  @@index([status])
  @@map("extraction_conversations")
}

// Mensajes de la conversación
model ConversationMessage {
  id                String   @id @default(cuid())
  conversationId    String

  // Mensaje
  role              MessageRole  // USER, ASSISTANT, SYSTEM
  content           String   @db.Text

  // Contexto
  fieldName         String?  // Campo sobre el que pregunta
  suggestedValue    Json?    // Valor sugerido por la IA
  confidence        Float?   // Confianza en la sugerencia

  // Metadata
  createdAt         DateTime @default(now())

  // Relaciones
  conversation      ExtractionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@map("conversation_messages")
}

// ==============================================================================
// SISTEMA OCR SEPARADO
// ==============================================================================

// Resultados del OCR (capa separada antes de extracción)
model OCRResult {
  id                String   @id @default(cuid())
  documentId        String   @unique
  tenantId          String

  // Proveedor usado
  provider          OCRProvider  // GOOGLE_VISION, TESSERACT, DIRECT_PDF

  // Resultados
  rawText           String   @db.Text  // Texto completo extraído
  confidence        Float?   // Confianza general del OCR

  // Metadatos del OCR
  language          String?  // Idioma detectado
  pageCount         Int?
  hasHandwriting    Boolean  @default(false)
  imageQuality      String?  // LOW, MEDIUM, HIGH

  // Resultados estructurados (opcional)
  blocks            Json?    // Bloques de texto con coordenadas
  words             Json?    // Palabras individuales

  // Performance
  processingTime    Int?     // ms
  costEstimate      Float?   // USD

  // Metadata
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([provider])
  @@map("ocr_results")
}

// ==============================================================================
// INTEGRACIÓN GOOGLE DRIVE
// ==============================================================================

// Archivos subidos a Google Drive
model DriveFile {
  id                String   @id @default(cuid())
  documentId        String
  tenantId          String

  // Google Drive info
  driveFileId       String   // ID del archivo en Google Drive
  fileName          String
  mimeType          String
  webViewLink       String?  // Link para ver el archivo
  webContentLink    String?  // Link para descargar

  // Organización
  folderId          String?  // ID de la carpeta en Drive
  folderPath        String?  // Path de la carpeta (ej: "Facturas/2025/Enero")

  // Metadata
  uploadedAt        DateTime @default(now())
  fileSize          Int?

  // Relaciones
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId])
  @@index([tenantId])
  @@index([driveFileId])
  @@map("drive_files")
}

// Integraciones con servicios externos (multi-tenant)
model Integration {
  id              String   @id @default(cuid())
  tenantId        String   // MULTI-TENANT: Aislado por tenant
  provider        String   // 'google', 'microsoft', 'dropbox'
  accessToken     String   // Encriptado con AES-256-CBC
  refreshToken    String?  // Encriptado con AES-256-CBC
  expiresAt       DateTime?

  // Configuración y metadata del proveedor
  metadata        Json?    // Email, displayName, accountId, etc.

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exports         ExportLog[]

  @@unique([tenantId, provider]) // Una integración por tenant y provider
  @@index([tenantId])
  @@map("integrations")
}

// Automatizaciones configuradas (multi-tenant)
model Automation {
  id              String   @id @default(cuid())
  tenantId        String   // MULTI-TENANT: Aislado por tenant
  userId          String
  name            String
  description     String?
  
  // Reglas
  trigger         Json     // Configuración del trigger
  actions         Json     // Array de acciones
  
  // Estado
  enabled         Boolean  @default(true)
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relaciones
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions      AutomationExecution[]
  
  @@index([tenantId, userId])
  @@index([tenantId, enabled])
  @@map("automations")
}

// Ejecuciones de automatizaciones
model AutomationExecution {
  id              String   @id @default(cuid())
  automationId    String
  documentId      String?
  
  // Resultado
  status          ExecutionStatus @default(PENDING)
  result          Json?
  errorMessage    String?
  
  // Metadata
  executedAt      DateTime @default(now())
  
  // Relaciones
  automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  
  @@index([automationId])
  @@index([status])
  @@index([executedAt])
  @@map("automation_executions")
}

// Logs de exportación
model ExportLog {
  id              String   @id @default(cuid())
  documentId      String
  integrationId   String
  destination     String   // URL o path del archivo exportado
  format          ExportFormat
  status          ExportStatus @default(PENDING)
  errorMessage    String?
  
  // Metadata
  exportedAt      DateTime @default(now())
  
  // Relaciones
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  integration     Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
  @@index([integrationId])
  @@index([exportedAt])
  @@map("export_logs")
}

// Enums
enum DocumentStatus {
  QUEUED
  PROCESSING
  CLASSIFYING
  EXTRACTING
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

enum DocumentType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  FACTURA_E
  FACTURA_M
  SERVICIO_LUZ
  SERVICIO_GAS
  SERVICIO_AGUA
  SERVICIO_INTERNET
  SERVICIO_TELEFONIA
  SERVICIO_CABLE
  IMPUESTO_ARBA
  IMPUESTO_ABL
  IMPUESTO_PATENTE
  IMPUESTO_IIBB
  IMPUESTO_MONOTRIBUTO
  IMPUESTO_GANANCIAS
  RESUMEN_TARJETA
  OTRO
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

enum ExportFormat {
